{
  "manifest_version": 3,
  "name": "抖音续看 - 记住看到哪了",
  "version": "1.3.0",
  "description": "自动记住抖音网页版长视频的播放位置，下次点一下接着看。显示格式为「作者名《视频标题》」。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*"
      ],
      "js": ["early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "抖音续看"
  }
}
